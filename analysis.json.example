{
  "_说明": "LoRA 融合诊断的可调阈值。把本文件复制成同目录的 analysis.json 再改；不建它就全用内置默认值。",
  "_提示": "下面这几个数原来是写死在 diagnose.py 里的，现在是配置。改完刷新页面即生效，不用重启查看器。",

  "_参数说明": {
    "outlier_sigma": "离群判定：某组合到其他组合的平均距离 > μ + N·σ 就算可疑。调大更宽松，调小更敏感。",
    "effect_weak": "有效性下限：与 baseline 的相对距离低于这个值判「无效」（加了等于没加）。",
    "effect_strong": "有效性上限：高于这个值判「显著」。",
    "saturation_drop": "饱和判定：相邻强度档的画面变化量跌到峰值的这个比例以下，就认为再加强度收益递减。",
    "interfere_ratio": "干扰判定：融合结果偏离「单用A / 单用B」中间态的程度，除以两者距离的一半；>1 说明跑到两者之外（往往意味着崩坏）。"
  },

  "outlier_sigma": 2.0,
  "effect_weak": 0.35,
  "effect_strong": 0.8,
  "saturation_drop": 0.45,
  "interfere_ratio": 1.0
}
